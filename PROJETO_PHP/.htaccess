Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Pastas internas nunca são entregues diretamente pelo Apache.
  RewriteRule ^(?:app|config|database|data|uploads|branding|tools)(?:/|$) - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
</IfModule>

# XAMPP clássico carrega PHP como módulo do Apache. Nessa topologia o próprio
# projeto garante folga para os uploads de documentos de até 15 MB.
<IfModule php_module>
  php_value upload_max_filesize 20M
  php_value post_max_size 24M
  php_value max_execution_time 120
  php_value max_input_time 120
  php_value memory_limit 256M
</IfModule>

<Files "logo-original.base64">
  Require all denied
</Files>

<FilesMatch "^(?:\.env|\.ht|composer\.(?:json|lock)|package(?:-lock)?\.json|.*\.(?:sqlite|sqlite3|db|sql))$">
  Require all denied
</FilesMatch>
