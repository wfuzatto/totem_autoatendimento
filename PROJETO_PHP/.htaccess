Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Pastas internas nunca são entregues diretamente pelo Apache.
  RewriteRule ^(?:app|config|database|data|uploads|branding|tools)(?:/|$) - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "^(?:\.env|\.ht|composer\.(?:json|lock)|package(?:-lock)?\.json|.*\.(?:sqlite|sqlite3|db|sql))$">
  Require all denied
</FilesMatch>
