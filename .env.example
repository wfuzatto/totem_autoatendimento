HOST=0.0.0.0
PORT=3080
ADMIN_PASSWORD=251933
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
BRANDING_DIR=./data/branding
PRINT_JOB_DIR=./data/print-jobs

# No Docker, o HUB injeta estes valores e persiste /app/data em volume.
# DATA_DIR=/app/data
# UPLOAD_DIR=/app/data/uploads
# BRANDING_DIR=/app/data/branding
# PRINT_JOB_DIR=/app/data/print-jobs

# Integração desacoplada com Face Scanner.
# No stack Docker do HUB:
# FACE_SCANNER_URL=http://face-scanner:8091
# Em teste no host, use o upstream HTTP local informado pelo launcher standalone
# do Face Scanner (o navegador continua acessando o Totem exclusivamente por HTTPS).
FACE_SCANNER_URL=
FACE_SCANNER_API_KEY=

# O Electron local pode continuar usando localhost HTTP internamente.
TOTEM_URL=http://127.0.0.1:3080

# HTTPS direto opcional para testes. Em produção Docker, TLS termina no gateway do HUB.
# HTTPS_PORT=3443
# HTTPS_KEY_FILE=/etc/ssl/private/totem.key
# HTTPS_CERT_FILE=/etc/ssl/certs/totem.crt

# Impressora POS 80 mm no modo ESC/POS real permanece no equipamento físico do Totem.
# PRINTER_DEVICE=/dev/usb/lp0

# KIOSK_DEVTOOLS=1
