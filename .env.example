PORT=3080
ADMIN_PASSWORD=251933
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
BRANDING_DIR=./data/branding
PRINT_JOB_DIR=./data/print-jobs

# O Electron local pode continuar usando localhost HTTP.
TOTEM_URL=http://127.0.0.1:3080

# HTTPS direto opcional para testes. O certificado precisa ser confiável no navegador.
# HTTPS_PORT=3443
# HTTPS_KEY_FILE=/etc/ssl/private/totem.key
# HTTPS_CERT_FILE=/etc/ssl/certs/totem.crt

# Produção recomendada: Caddy/Nginx em HTTPS 443 -> 127.0.0.1:3080.

# Impressora POS 80 mm no modo ESC/POS real.
# PRINTER_DEVICE=/dev/usb/lp0

# KIOSK_DEVTOOLS=1
