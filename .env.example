HOST=0.0.0.0
PORT=3080
ADMIN_PASSWORD=CHANGE_ME
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
BRANDING_DIR=./data/branding
PRINT_JOB_DIR=./data/print-jobs

# No Docker, o HUB injeta estes valores e persiste /app/data em volume.
# DATA_DIR=/app/data
# UPLOAD_DIR=/app/data/uploads
# BRANDING_DIR=/app/data/branding
# PRINT_JOB_DIR=/app/data/print-jobs

# Integração desacoplada com Face Scanner.
FACE_SCANNER_URL=
FACE_SCANNER_API_KEY=

# Todo PIX/debito/credito passa pelo gateway central.
PAYMENT_GATEWAY_URL=http://api-payment:3090
PAYMENT_GATEWAY_API_KEY=CHANGE_ME_PAYMENT_API_KEY
PAYMENT_GATEWAY_TIMEOUT_MS=15000
PAYMENT_UI_WAIT_MS=90000
PAYMENT_UI_POLL_MS=750
PAYMENT_MERCHANT_ID=totem_hotel
PAYMENT_TERMINAL_ID=totem-hotel-01

# O Electron local pode continuar usando localhost HTTP internamente.
TOTEM_URL=http://127.0.0.1:3080

# HTTPS direto opcional para testes. Em produção Docker, TLS termina no gateway do HUB.
# HTTPS_PORT=3443
# HTTPS_KEY_FILE=/etc/ssl/private/totem.key
# HTTPS_CERT_FILE=/etc/ssl/certs/totem.crt

# Impressora POS 80 mm no modo ESC/POS real permanece no equipamento físico do Totem.
# PRINTER_DEVICE=/dev/usb/lp0

# KIOSK_DEVTOOLS=1

# NFC real: backend Node -> BisApi no Windows. Nunca colocar estes segredos no frontend.
# mock somente para testes explícitos; produção sem provider definido usa bis_api.
HOTEL_CARD_PROVIDER=bis_api
BIS_API_URL=
# Mesmo valor de BisApi.RequireWriteChallenge. NÃO é o HPASS.
BIS_API_WRITE_CONFIRMATION=
BIS_API_TIMEOUT_MS=15000
HOTEL_ACCESS_CHECKIN_TIME=14:00
HOTEL_ACCESS_CHECKOUT_TIME=12:00
HOTEL_ACCESS_UTC_OFFSET=-03:00
# HPASS é obrigatório e permanece apenas em BeTech57.HotelPassword no Windows.
