# Totem Autoatendimento V2 - Docker
# Copie para .env antes de subir: cp .env.example .env

TOTEM_IMAGE_NAME=totem-autoatendimento:v2
TOTEM_CONTAINER_NAME=totem-autoatendimento-v2
TOTEM_HTTP_PORT=8080
TZ=America/Sao_Paulo

# Senha inicial da área administrativa. É aplicada ao criar um banco novo.
TOTEM_ADMIN_PASSWORD=251933

# Opcional. Ex.: https://totem.valedamantiqueira.com.br
TOTEM_PUBLIC_BASE_URL=

# Opcional. Se vazio, o sistema gera e persiste um segredo no volume de dados.
TOTEM_EXIT_SECRET=

# Opcional para futura impressora ESC/POS real.
TOTEM_PRINTER_DEVICE=

# Nomes dos volumes persistentes. Só altere se quiser isolar outra instalação.
TOTEM_DATA_VOLUME=totem_autoatendimento_v2_data
TOTEM_UPLOADS_VOLUME=totem_autoatendimento_v2_uploads
TOTEM_BRANDING_VOLUME=totem_autoatendimento_v2_branding
