{
  "name": "totem-autoatendimento",
  "version": "0.5.0",
  "private": true,
  "description": "Totem hoteleiro de check-in e check-out com pagamentos centralizados e integracoes desacopladas",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/server-main.js",
    "dev": "node --watch src/server-main.js",
    "kiosk": "electron .",
    "check": "node --check src/server-main.js && node --check src/payment-gateway.js && node --check src/payment-runtime.js",
    "test": "NODE_ENV=test PAYMENT_ALLOW_LEGACY_MOCK=1 node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsqr": "^1.4.0",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "nfc-pcsc": "^0.8.1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.0"
  }
}
